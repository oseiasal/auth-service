# --- Build Stage ---
FROM golang:alpine AS builder

WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the source code
COPY . .

# Upgrade transitive crypto dependency to patch CVEs and build the application
RUN go get golang.org/x/crypto@latest && go mod tidy && CGO_ENABLED=0 GOOS=linux go build -o main .

# --- Final Stage ---
FROM alpine:latest

# Install ca-certificates and security upgrades for HTTPS requests
RUN apk update && apk upgrade --no-cache && apk --no-cache add ca-certificates

# Create a non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy the binary from the builder stage
COPY --from=builder /app/main .

# Change ownership
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Expose the port
EXPOSE 8001

# Run the binary
CMD ["./main"]
